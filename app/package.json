{
  "name": "agent-tea-party",
  "version": "1.1.0",
  "description": "Agent 茶话会 — 本地优先的多 Agent 聊天工作台",
  "main": "./out/main/index.js",
  "author": "Agent Tea Party",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "dist": "electron-vite build && electron-builder --win nsis portable",
    "dist:dev": "electron-vite build && electron-builder --win portable -c.extraMetadata.teaDevBuild=true -c.directories.output=../release-dev -c.portable.artifactName=Agent-Tea-Party-Dev-${version}.${ext}",
    "dist:dir": "electron-vite build && electron-builder --win dir"
  },
  "dependencies": {
    "lucide-react": "^0.545.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.0",
    "remark-gfm": "^4.0.1",
    "sql.js": "^1.13.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sql.js": "^1.16.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.8",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.agentteaparty.app",
    "productName": "Agent 茶话会",
    "copyright": "Copyright © 2026 Agent Tea Party",
    "directories": {
      "output": "../release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/characters",
        "to": "characters"
      }
    ],
    "asarUnpack": [
      "node_modules/sql.js/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Agent-Tea-Party-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Agent 茶话会",
      "artifactName": "Agent-Tea-Party-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Agent-Tea-Party-Portable-${version}.${ext}"
    }
  }
}
